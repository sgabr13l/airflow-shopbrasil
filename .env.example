# Copie para .env e ajuste se necessario:  cp .env.example .env
# Todas as variaveis tem padrao no docker-compose.yaml; o .env e opcional.

# --- Airflow -----------------------------------------------------------------
# Em Linux/WSL use o seu UID (comando: id -u) para evitar erro de permissao
# nas pastas dags/, logs/ e plugins/. Em Docker Desktop (Windows/Mac) tanto faz.
AIRFLOW_UID=1000
AIRFLOW_IMAGE=apache/airflow:2.11.2-python3.12
AIRFLOW_WEB_PORT=8080

# Usuario da interface web (ambiente local de estudo)
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# --- Base analitica (PostgreSQL) ----------------------------------------------
ANALYTICS_DB=shopbrasil
ANALYTICS_USER=shopbrasil
ANALYTICS_PASSWORD=shopbrasil
# Porta no host para inspecionar com DBeaver/psql (5433 evita conflito com um
# Postgres local na 5432)
ANALYTICS_PORT=5433
